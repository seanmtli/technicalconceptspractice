# LLM (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_EVAL_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_CHEAP_MODEL=google/gemini-2.5-flash

# Speech-to-text (https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # scripts only
SUPABASE_DB_PASSWORD=your_db_password             # supabase db push
